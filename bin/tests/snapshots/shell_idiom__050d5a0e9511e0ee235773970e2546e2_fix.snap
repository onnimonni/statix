+++ <temp_file_path> [fixed]
@@ -1,4 +1,4 @@
 stdenv.mkDerivation { installPhase = ''
-  cp -r dist $out
-  chmod 755 $out
+  cp -r dist "$out"
+  chmod 755 "$out"
 ''; }
