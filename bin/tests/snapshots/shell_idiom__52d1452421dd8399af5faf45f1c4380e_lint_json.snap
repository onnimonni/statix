        {
          "at": {
            "from": {
              "line": 3,
              "column": 3
            },
            "to": {
              "line": 3,
              "column": 20
            }
          },
          "message": "stdenv phases already run with `set -eu -o pipefail`",
          "suggestion": null,
          "fixable": false,
          "help": "Remove the line."
        }
      ]
    }
  ]
}
