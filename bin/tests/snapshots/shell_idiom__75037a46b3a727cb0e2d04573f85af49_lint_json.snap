              "from": {
                "line": 1,
                "column": 38
              },
              "to": {
                "line": 9,
                "column": 3
              }
            },
            "fix": "''\n  cat \"$files\" | sort > all\n  n=$(grep pat lib/*.php | wc -l)\n  sort -k2 x | uniq\n  mkdir -p \"$out\"/a\n  mkdir -p \"$out\"/b\n  v=$(cat \"$f\")\n  sed -i 's,#!/usr/bin/env bash,#!${stdenv.shell},' x\n''"
          },
          "fixable": true
        },
        {
