              "column": 3
            },
            "to": {
              "line": 2,
              "column": 26
            }
          },
          "message": "`cat` only feeds `sort`: read the file directly",
          "suggestion": null,
          "fixable": false,
          "help": "Use `sort > all < $files`."
        },
        {
          "at": {
            "from": {
              "line": 2,
