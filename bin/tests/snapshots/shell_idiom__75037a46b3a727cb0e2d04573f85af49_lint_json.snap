---
source: bin/tests/shell_idiom.rs
---
stdenv.mkDerivation { installPhase = ''
  cat $files | sort > all
  n=$(grep pat lib/*.php | wc -l)
  sort -k2 x | uniq
  mkdir -p $out/a
  mkdir -p $out/b
  v=$(cat "$f")
  sed -i 's,#!/usr/bin/env bash,#!${stdenv.shell},' x
''; }
---
{
  "file": "<temp_file_path>",
  "report": [
    {
      "name": "shellcheck",
      "note": "ShellCheck found issues in an inline shell script",
      "code": 28,
      "severity": "Hint",
      "diagnostics": [
        {
          "at": {
            "from": {
              "line": 2,
              "column": 7
            },
