              "line": 5,
              "column": 3
            },
            "to": {
              "line": 6,
              "column": 18
            }
          },
          "message": "`mkdir -p` takes several directories: `mkdir -p $out/a $out/b`",
          "suggestion": {
            "at": {
              "from": {
                "line": 1,
                "column": 38
              },
              "to": {
                "line": 9,
                "column": 3
              }
            },
            "fix": "''\n  cat $files | sort > all\n  n=$(grep pat lib/*.php | wc -l)\n  sort -k2 x | uniq\n  mkdir -p $out/a $out/b\n  v=$(<\"$f\")\n  sed -i 's,#!/usr/bin/env bash,#!${stdenv.shell},' x\n''"
          },
          "fixable": true
        },
        {
          "at": {
            "from": {
              "line": 7,
