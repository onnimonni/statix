---
source: bin/tests/shell_idiom.rs
---
stdenv.mkDerivation { installPhase = ''
  mkdir -p $out/share/doc
  cp README.md NEWS $out/share/doc
''; }
---
--- <temp_file_path>
+++ <temp_file_path> [fixed]
@@ -1,4 +1,6 @@
 stdenv.mkDerivation { installPhase = ''
-  mkdir -p $out/share/doc
-  cp README.md NEWS $out/share/doc
+  runHook preInstall
+  mkdir -p "$out"/share/doc
+  cp README.md NEWS "$out"/share/doc
+  runHook postInstall
 ''; }
